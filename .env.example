# Required for browser speech recognition -> Gemini -> Rime practice
GEMINI_API_KEY=replace-with-your-gemini-api-key
RIME_API_KEY=replace-with-your-rime-api-key

# Optional: separate LiveKit worker integration in src/agent/index.ts
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-with-your-livekit-api-key
LIVEKIT_API_SECRET=replace-with-your-livekit-api-secret
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key